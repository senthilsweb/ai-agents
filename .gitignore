# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (per-agent .env files are also ignored; .env.example is tracked)
.env*.local
.env
agents/*/.env
agents/*/.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eve build artifacts (per-agent)
/.eve
/.output
/.workflow-data
agents/*/.eve
agents/*/.output
agents/*/.workflow-data

# live run outputs (keep example runs, ignore new ones)
agents/diagram-generator/agent/sandbox/workspace/runs/*
!agents/diagram-generator/agent/sandbox/workspace/runs/.gitkeep
!agents/diagram-generator/agent/sandbox/workspace/runs/2026-06-20T15-14-27Z/
!agents/diagram-generator/agent/sandbox/workspace/runs/2026-06-20T20-14-42Z/

# subagent workspace runs (live outputs, keep .gitkeep)
agents/diagram-generator/agent/subagents/*/sandbox/workspace/runs/*
!agents/diagram-generator/agent/subagents/*/sandbox/workspace/runs/.gitkeep

# linkedin-cover run outputs (keep .gitkeep)
agents/linkedin-cover-generator/agent/sandbox/workspace/runs/*
!agents/linkedin-cover-generator/agent/sandbox/workspace/runs/.gitkeep
