# ── Model selection ──────────────────────────────────────────────────────
# The eve CLI loads .env / .env.local from the app root automatically.
# Copy this file to .env and fill in your provider.

# Model id your provider expects. Defaults to deepseek-v4-pro.
MODEL=deepseek-v4-pro

# OpenAI-compatible base URL. Defaults to DeepSeek.
# Examples:
#   DeepSeek:     https://api.deepseek.com
#   OpenRouter:   https://openrouter.ai/api/v1
#   OpenAI:       https://api.openai.com/v1
MODEL_BASE_URL=https://api.deepseek.com

# Provider API key. MODEL_API_KEY is preferred; DEEPSEEK_API_KEY is read as a
# convenience alias. Falls back to AI_GATEWAY_API_KEY for the gateway path.
MODEL_API_KEY=sk-your-key-here

# ── Gateway path (optional) ──────────────────────────────────────────────
# To use the Vercel AI Gateway instead, leave MODEL_BASE_URL unset and set:
#   MODEL=anthropic/claude-sonnet-4.6
#   AI_GATEWAY_API_KEY=...
