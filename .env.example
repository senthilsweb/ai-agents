# ── Per-role model selection ──────────────────────────────────────────────
# The eve CLI loads .env / .env.local from the app root automatically.
# Copy this file to .env and fill in your provider.
#
# The orchestrator, renderer, and reporter each use a DIFFERENT model. Set
# role-specific vars (they fall back to the generic MODEL* vars):
#
#   MODEL_ORCHESTRATOR          (fallback: MODEL)
#   MODEL_ORCHESTRATOR_BASE_URL (fallback: MODEL_BASE_URL)
#   MODEL_ORCHESTRATOR_API_KEY  (fallback: MODEL_API_KEY)
#
#   MODEL_RENDERER              (fallback: MODEL)
#   MODEL_RENDERER_BASE_URL     (fallback: MODEL_BASE_URL)
#   MODEL_RENDERER_API_KEY      (fallback: MODEL_API_KEY)
#
#   MODEL_REPORTER              (fallback: MODEL)
#   MODEL_REPORTER_BASE_URL     (fallback: MODEL_BASE_URL)
#   MODEL_REPORTER_API_KEY      (fallback: MODEL_API_KEY)
#
# If only MODEL* is set, all three roles use the same model (backwards compat).

# ── Example A: same model for all roles (simplest) ────────────────────────
# MODEL=deepseek-v4-pro
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_API_KEY=sk-your-key-here

# ── Example B: reasoning orchestrator + fast renderer/reporter (z.ai) ─────
# Use a strong reasoning model for the orchestrator (spec analysis, layout
# planning) and a fast non-reasoning model for rendering and reporting.
MODEL_ORCHESTRATOR=glm-5.2
MODEL_ORCHESTRATOR_BASE_URL=https://api.z.ai/api/paas/v4/
MODEL_ORCHESTRATOR_API_KEY=your-z-ai-key

MODEL_RENDERER=glm-4.5-air
MODEL_RENDERER_BASE_URL=https://api.z.ai/api/paas/v4/
MODEL_RENDERER_API_KEY=your-z-ai-key

MODEL_REPORTER=glm-4.5-air
MODEL_REPORTER_BASE_URL=https://api.z.ai/api/paas/v4/
MODEL_REPORTER_API_KEY=your-z-ai-key

# ── Example C: different providers per role ───────────────────────────────
# MODEL_ORCHESTRATOR=anthropic/claude-sonnet-4.6
# MODEL_ORCHESTRATOR_BASE_URL=https://api.anthropic.com
# MODEL_ORCHESTRATOR_API_KEY=sk-ant-...
#
# MODEL_RENDERER=gpt-4o-mini
# MODEL_RENDERER_BASE_URL=https://api.openai.com/v1
# MODEL_RENDERER_API_KEY=sk-...
#
# MODEL_REPORTER=gpt-4o-mini
# MODEL_REPORTER_BASE_URL=https://api.openai.com/v1
# MODEL_REPORTER_API_KEY=sk-...

# ── Context window override (optional) ────────────────────────────────────
# Override per role if your model has a different context window:
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# MODEL_RENDERER_CONTEXT_WINDOW_TOKENS=128000
# MODEL_REPORTER_CONTEXT_WINDOW_TOKENS=128000
# Or set a single fallback for all roles:
# MODEL_CONTEXT_WINDOW_TOKENS=128000

# ── Gateway path (optional) ──────────────────────────────────────────────
# To use the Vercel AI Gateway instead, leave BASE_URL unset for a role and set:
#   MODEL_ORCHESTRATOR=anthropic/claude-sonnet-4.6
#   AI_GATEWAY_API_KEY=...

# ── linkedin-cover-generator (separate .env) ──────────────────────────────
# The LinkedIn cover agent has its own .env at
# agents/linkedin-cover-generator/.env.example. Eve loads it from the agent
# folder when you run `eve dev` from there. Key vars:
#
#   MODEL_ORCHESTRATOR=glm-4.5-air          (z.ai, cheap reasoning)
#   MODEL_ORCHESTRATOR_BASE_URL=https://api.z.ai/api/paas/v4/
#   MODEL_ORCHESTRATOR_API_KEY=your-z-ai-key
#   IMAGE_MODEL=gpt-image-2                 (OpenAI image generation)
#   IMAGE_BASE_URL=https://api.openai.com/v1
#   IMAGE_API_KEY=your-openai-key
#   ENABLE_REVIEW=false
#   MAX_IMAGE_RETRIES=0
