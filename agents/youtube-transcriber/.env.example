# youtube-transcriber — every value here is optional for LOCAL use.
# There is no model API key, because there is no model API call.
# For a PUBLIC deployment (docker-compose.yaml + tunnel), TRANSCRIBER_API_KEY
# is required before creating any public route.

# --- Service auth (deploy-stats-managed-agent) --------------------------
# Unset = open service (local/loopback only). Set = every endpoint except
# GET /healthz requires a matching X-API-Key header.
# Generate: openssl rand -hex 24
TRANSCRIBER_API_KEY=

# --- Object-store mirror (add-object-store-state) -----------------------
# When set, every completed run uploads its artifacts to
# s3://$OBJECT_STORE_BUCKET/youtube-transcriber/runs/<stamp>-<id>/.
# NOTE: the owner's MinIO serves its S3 API on the minio-console. hostname.
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_FORCE_PATH_STYLE=true

# --- ASR (local faster-whisper) ---------------------------------------
# distil-large-v3 is the pinned default: accuracy over speed (gate 2026-07-23).
# Faster alternatives if you want the trade: large-v3-turbo, small.en
ASR_MODEL=distil-large-v3
# int8 (CPU, default) | int8_float16 | float16 | float32
ASR_COMPUTE_TYPE=int8
# Blank = auto-detect. Set to en / ta / hi ... to force.
ASR_LANGUAGE=
ASR_BEAM_SIZE=5
# Voice-activity detection: skips silence and suppresses hallucinated text
# in silent passages. Leave on unless you are debugging.
ASR_VAD=1

# --- Limits ------------------------------------------------------------
MAX_DURATION_MIN=180
MAX_FILESIZE_MB=200

# --- YouTube bot-blocking ---------------------------------------------
# Path to a Netscape-format cookie file, if YouTube starts refusing
# downloads. Never commit this file.
YT_COOKIES_FILE=

# --- Telemetry (all optional; missing values degrade to a warning) ------
# Same dual-export contract as job-pilot. Copy the values from
# agents/job-pilot/.env, but keep LANGSMITH_PROJECT pointed here so this
# agent's traces don't land in job-pilot's project.

# LangSmith — native to LangGraph, env-only, no wiring code.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=youtube-transcriber

# OpenObserve. Accepts .../api/default or a full .../v1/traces URL.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Arize / Phoenix. PHOENIX_CLIENT_HEADERS is only needed for the hosted
# service; a local Docker Phoenix ignores it.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_CLIENT_HEADERS=
