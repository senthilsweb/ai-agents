<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}AI Value Stats{% endblock %}</title>
  <meta name="description" content="{% block description %}Hard business numbers, pulled from AI talks and grounded to the exact quote.{% endblock %}" />
  {% block head_extra %}{% endblock %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Newsreader:ital,opsz,wght@1,6..72,400;0,6..72,500&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --paper:#f5f2ea; --card:#fbf9f4; --ink:#1a1712; --muted:#8b8478; --line:#e2dccf;
      --accent:#1f7a55; --accent-soft:rgba(31,122,85,.09); --down:#2f6bd9; --rail:96px;
    }
    *{box-sizing:border-box} html{-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--paper);color:var(--ink);
      font-family:"Space Grotesk",system-ui,-apple-system,sans-serif;line-height:1.5;
      -webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:820px;margin:0 auto;padding:0 22px 96px}
    .mono{font-family:"JetBrains Mono",ui-monospace,monospace}

    /* ---- sticky app bar (both pages) ---- */
    .bar{position:sticky;top:0;z-index:20;background:rgba(245,242,234,.82);
      backdrop-filter:saturate(1.3) blur(10px);border-bottom:1px solid var(--line)}
    .bar .in{max-width:820px;margin:0 auto;padding:11px 22px;display:flex;align-items:center;gap:14px}
    .bar a.back,.bar .mark{display:inline-flex;align-items:center;gap:8px;font:600 12px "JetBrains Mono",monospace;
      letter-spacing:.06em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
    .bar a.back:hover,.bar .pq:hover{color:var(--accent)}
    .bar .mark{color:var(--ink)} .bar .mark .d{width:9px;height:9px;background:var(--accent);border-radius:2px;transform:rotate(45deg)}
    .bar .ttl{flex:1;font-size:13px;font-weight:600;color:#545047;overflow:hidden;text-overflow:ellipsis;
      white-space:nowrap;opacity:0;transition:opacity .2s}
    .bar.scrolled .ttl{opacity:1}
    .bar .right{margin-left:auto;font:600 11px "JetBrains Mono",monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}

    /* ---- compact hero (index) ---- */
    .hero{padding:30px 0 22px;border-bottom:1px solid var(--line)}
    .hero .k{font:600 11px "JetBrains Mono",monospace;letter-spacing:.24em;text-transform:uppercase;color:var(--accent)}
    .hero h1{margin:10px 0 0;font-size:clamp(26px,4.6vw,36px);font-weight:700;letter-spacing:-.025em;line-height:1.05;max-width:20ch;overflow-wrap:break-word}
    .hero p{margin:9px 0 0;font-size:14.5px;color:var(--muted);max-width:58ch}

    /* ---- list ---- */
    ul.list{list-style:none;margin:6px 0 0;padding:0}
    ul.list li a{display:grid;grid-template-columns:136px 1fr auto;gap:20px;align-items:center;
      padding:20px 0;border-bottom:1px solid var(--line)}
    ul.list li a:hover .t{color:var(--accent)}
    .thumb{position:relative;aspect-ratio:16/9;border-radius:8px;overflow:hidden;background:#e6e1d6}
    .thumb img{width:100%;height:100%;object-fit:cover;display:block}
    .thumb .play{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(0deg,rgba(0,0,0,.3),transparent 60%)}
    .lc .c{font:600 10.5px "JetBrains Mono",monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    .lc .t{margin:4px 0 0;font-weight:600;font-size:16.5px;line-height:1.25;letter-spacing:-.01em;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .lc .a{margin-top:5px;font-size:12.5px;color:var(--muted)}
    .lstat{text-align:right;white-space:nowrap}
    .lstat .v{font-size:27px;font-weight:700;letter-spacing:-.02em}
    .lstat .l{font:600 10px "JetBrains Mono",monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);max-width:13ch;margin-left:auto}
    .pqline{margin-top:26px;font-size:12.5px;color:var(--muted);text-align:center}
    .pqline a{color:var(--accent);font-weight:600}

    /* ---- detail header ---- */
    header.talk{margin-top:30px;display:grid;grid-template-columns:1.5fr 1fr;gap:28px;align-items:center}
    .chan{font:600 11px "JetBrains Mono",monospace;letter-spacing:.24em;text-transform:uppercase;color:var(--accent)}
    header.talk h1{margin:12px 0 0;font-size:clamp(28px,5.2vw,44px);font-weight:700;letter-spacing:-.03em;line-height:1.0;overflow-wrap:break-word}
    .deck{margin:16px 0 0;font-family:"Newsreader",Georgia,serif;font-style:italic;font-size:18px;color:#4a463d;max-width:42ch}
    .vthumb{position:relative;border-radius:8px;overflow:hidden;aspect-ratio:4/3;box-shadow:0 14px 34px rgba(26,23,18,.16)}
    .vthumb img{width:100%;height:100%;object-fit:cover;display:block}
    .vthumb .play{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(0deg,rgba(0,0,0,.35),transparent 60%)}
    .vthumb .dur{position:absolute;right:8px;bottom:8px;font:600 11px "JetBrains Mono",monospace;color:#fff;background:rgba(0,0,0,.6);padding:2px 6px;border-radius:4px}
    .who{display:flex;flex-wrap:wrap;gap:14px 20px;margin:22px 0 0;padding-top:16px;border-top:1px solid var(--line)}
    .who .p{display:flex;align-items:center;gap:11px}
    .av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--paper);font-weight:700;font-size:14px}
    .who .n{font-weight:600;font-size:14.5px} .who .r{font-size:12px;color:var(--muted)}

    /* ---- horizontal talk-scrubber ---- */
    .scrub{margin-top:28px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px 12px}
    .scrub .top{display:flex;justify-content:space-between;align-items:baseline;font:600 11px "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .scrub .top b{color:var(--ink)}
    .track{position:relative;height:40px;margin-top:8px}
    .track .line{position:absolute;left:0;right:0;top:50%;height:2px;background:var(--line);border-radius:2px}
    .track .tick{position:absolute;top:50%;width:26px;height:26px;transform:translate(-50%,-50%)}
    .track .tick .dot{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px var(--card);transition:transform .15s}
    .track .tick .bub{position:absolute;left:50%;bottom:20px;transform:translateX(-50%);font:600 11px "Space Grotesk";background:var(--ink);color:var(--paper);padding:3px 8px;border-radius:6px;white-space:nowrap;opacity:0;transition:opacity .15s;pointer-events:none}
    .track .tick:hover{z-index:3}
    .track .tick:hover .dot{transform:translate(-50%,-50%) scale(1.4)}
    .track .tick:hover .bub{opacity:1}
    .track .ends{position:absolute;left:0;right:0;top:calc(50% + 14px);display:flex;justify-content:space-between;font:500 10.5px "JetBrains Mono",monospace;color:var(--muted)}

    /* ---- vertical timeline ---- */
    .tl{position:relative;margin-top:40px}
    .tl::before{content:"";position:absolute;left:calc(var(--rail) - 1px);top:6px;bottom:0;width:2px;background:var(--line)}
    .chapter{position:relative;display:grid;grid-template-columns:var(--rail) 1fr;gap:26px;margin:40px 0 6px}
    .chapter .spine{display:flex;justify-content:flex-end;padding-right:14px}
    .chapter .cdot{width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px var(--paper),0 0 0 6px var(--line);margin-top:6px}
    .chapter h2{margin:0;font-size:21px;font-weight:700;letter-spacing:-.01em}
    .chapter .org{margin-top:4px;font:600 11px "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .chapter .sum{margin-top:8px;color:#57534a;font-size:14.5px;max-width:52ch}

    .node{position:relative;display:grid;grid-template-columns:var(--rail) 1fr;gap:26px;padding:20px 0;border-radius:12px;transition:background .15s}
    .node:hover{background:var(--accent-soft)}
    .node .when{text-align:right;padding-right:26px;position:relative}
    .node .when span{font:600 12px "JetBrains Mono",monospace;color:var(--muted)}
    .node:hover .when span{color:var(--accent)}
    .node .when::after{content:"";position:absolute;right:-5px;top:15px;width:9px;height:9px;border-radius:50%;background:var(--paper);border:2px solid var(--accent);transition:transform .15s}
    .node:hover .when::after{transform:scale(1.35)}
    .node.neutral .when::after{border-color:var(--muted)}
    .num{font-size:clamp(38px,8.4vw,64px);font-weight:700;letter-spacing:-.035em;line-height:.9;display:flex;align-items:baseline;gap:.2em}
    .num .ar{font-size:.3em}
    .up .ar{color:var(--accent)} .down .ar{color:var(--down)} .neutral .ar{color:var(--muted)}
    .cat{margin-top:10px;font:600 10.5px "JetBrains Mono",monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
    .lab{margin-top:2px;font-size:16px;font-weight:600}
    .conf{margin-left:8px;font:600 9.5px "JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--paper);background:var(--muted);padding:1px 6px;border-radius:3px;vertical-align:middle}
    .q{margin:12px 0 0;font-family:"Newsreader",Georgia,serif;font-style:italic;font-size:16px;color:#3f3b33;max-width:48ch}

    footer{max-width:820px;margin:64px auto 0;padding:18px 22px 0;border-top:1px solid var(--line);font-size:12px;color:var(--muted);text-align:center}
    footer p{margin:0 0 6px}
    footer a.gh{display:inline-flex;align-items:center;gap:6px;color:var(--accent);font-weight:600;font-family:"JetBrains Mono",monospace;letter-spacing:.03em}
    footer a.gh:hover{text-decoration:underline}

    @media(max-width:600px){
      :root{--rail:56px}
      header.talk{grid-template-columns:1fr}.vthumb{order:-1;aspect-ratio:16/9}
      .node,.chapter{gap:14px}.node .when{padding-right:14px}.chapter .spine{padding-right:5px}
      .bar .ttl{display:none}
      ul.list li a{grid-template-columns:104px 1fr;gap:14px}
      .lstat{grid-column:2;text-align:left;display:flex;align-items:baseline;gap:8px;margin-top:2px}
      .lstat .l{margin:0;max-width:none}
    }
  </style>
</head>
<body>
  {% block bar %}{% endblock %}
  <div class="wrap">
    {% block body %}{% endblock %}
  </div>
  <footer>
    <p>Numbers are the speakers' own claims, shown with evidence for context — not independently verified.</p>
    <p><a class="gh" href="https://github.com/senthilsweb/ai-agents/tree/main/agents/talk-value-stats" target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1-.015-1.963-3.196.695-3.87-1.54-3.87-1.54-.523-1.33-1.276-1.684-1.276-1.684-1.043-.713.08-.699.08-.699 1.153.081 1.76 1.184 1.76 1.184 1.026 1.758 2.692 1.25 3.348.956.104-.743.401-1.25.73-1.538-2.552-.29-5.236-1.276-5.236-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.459.112-3.042 0 0 .965-.309 3.163 1.178a11 11 0 0 1 5.76 0c2.196-1.487 3.16-1.178 3.16-1.178.626 1.583.232 2.752.114 3.042.737.804 1.182 1.83 1.182 3.084 0 4.415-2.688 5.386-5.248 5.67.413.356.78 1.057.78 2.13 0 1.538-.014 2.778-.014 3.157 0 .308.207.667.79.554A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
      Source &amp; method on GitHub ↗</a></p>
  </footer>
  {% block scripts %}{% endblock %}
</body>
</html>
