# ── Privacy Classifier — environment configuration ─────────────────────────
#
# Eve loads .env / .env.local from the agent folder when you run `eve dev`
# from agents/privacy-classifier/. This keeps each agent's secrets isolated.
#
# Copy this file to .env in this folder:
#   cp .env.example .env
#
# Models are model-agnostic and env-driven. There is NO built-in default model
# id — each role resolves MODEL_<ROLE>_* -> MODEL_* -> an explicit startup
# error. See openspec/adr/0001-shared-agent-runtime-kit.md §4.
#
# This agent bootstraps Python + Docling + Presidio + Chonkie into its own
# sandbox on first build — local/on-prem only, not Vercel-serverless-
# compatible. See PREREQUISITES.md before deploying anywhere but local dev.

# ── Detection engine (REQUIRED, no default) ────────────────────────────────
# Exactly one of the four below. Unset or invalid = startup error.
#   presidio                  local, statistical/NER-based, no GenAI call
#   presidio_genai             Presidio AND GenAI both run, findings merged
#   openai_privacy_filter      RESERVED, not yet implemented — see agent/lib/engine.ts.
#                              A local, non-generative Python package (not an
#                              LLM, despite the name); exact package pending.
#                              Selecting it fails fast with a clear TODO error.
#   genai_only                 a full/cloud frontier model
PII_ENGINE=genai_only

# ── Orchestrator (coordinates the deterministic pipeline) ──────────────────
MODEL_ORCHESTRATOR=claude-sonnet-5
MODEL_ORCHESTRATOR_BASE_URL=
MODEL_ORCHESTRATOR_API_KEY=your-key

# ── PII detector (genai_only / presidio_genai — glue/extraction, not reasoning) ─
# Point at a cloud/gateway model. Not needed for the presidio-only engine or
# (once implemented) openai_privacy_filter.
MODEL_PII_DETECTOR=gpt-4o-mini
MODEL_PII_DETECTOR_BASE_URL=https://api.openai.com/v1
MODEL_PII_DETECTOR_API_KEY=your-key

# ── Detection prompt (changeable without a code change) ────────────────────
# Precedence: per-invocation system_prompt arg > PII_SYSTEM_PROMPT (inline) >
# PII_SYSTEM_PROMPT_FILE (path) > the bundled agent/config/detection_prompt.default.md
# PII_SYSTEM_PROMPT=
# PII_SYSTEM_PROMPT_FILE=
PII_DETECTION_CONCURRENCY=5

# ── Presidio (used when PII_ENGINE is presidio or presidio_genai) ──────────
# Runs as a CLI script inside this agent's own sandbox — no separate service.
PRESIDIO_LANGUAGE=en
PRESIDIO_SCORE_THRESHOLD=0.4

# ── Chunking (semantic, Chonkie; see agent/config/chunking.yaml) ───────────
# CHUNKING_CONFIG_FILE=agent/config/chunking.yaml

# ── Taxonomy / compliance matrix overrides (optional) ───────────────────────
# Defaults ship in shared/config/{label_aliases,compliance_matrix}.yaml.
# LABEL_ALIASES_FILE=
# COMPLIANCE_MATRIX_FILE=

# ── Cost reporting ──────────────────────────────────────────────────────────
ALLOW_COST=true

# ── Generic fallback (simplest single-model setup) ────────────────────────
# MODEL=gpt-4o-mini
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=your-key

# ── Vercel AI Gateway (optional) ──────────────────────────────────────────
# MODEL_ORCHESTRATOR=anthropic/claude-sonnet-5
# AI_GATEWAY_API_KEY=...
# (leave BASE_URL unset for the gateway path)

# ── Soft run budgets (observability only) ─────────────────────────────────
# RUN_STEP_BUDGET=40
# RUN_WALL_CLOCK_BUDGET_S=600

# ── Context window override (optional) ────────────────────────────────────
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# MODEL_CONTEXT_WINDOW_TOKENS=128000

# ── Observability (optional; off unless an endpoint is set) ────────────────
# Traces export via the shared OTel pipeline (shared/lib/instrumentation.ts).
# Local Phoenix: `docker compose up -d` from the repo root.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_CLIENT_HEADERS=api_key=your-key

# Second/alternative OTLP backend (e.g. OpenObserve). Setting BOTH endpoint
# vars fans every span out to both backends independently.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://openobserve.example.com/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 user:password>

# TELEMETRY_RECORD_IO=true

# ── Object storage for run artifacts (optional; no-op unless bucket set) ───
# OBJECT_STORE_BUCKET=my-agent-runs
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ACCESS_KEY_ID=...
# OBJECT_STORE_SECRET_ACCESS_KEY=...
# OBJECT_STORE_ENDPOINT=https://minio.internal:9000
# OBJECT_STORE_FORCE_PATH_STYLE=true
# OBJECT_STORE_PUBLIC_BASE_URL=https://cdn.example.com
