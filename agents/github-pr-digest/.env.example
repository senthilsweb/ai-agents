# GitHub authentication (fine-grained PAT or GitHub App token)
GITHUB_TOKEN=github_pat_xxx

# JSON array of owner/repository names used when the prompt omits repositories.
GITHUB_REPOSITORIES=["vercel/eve","senthilsweb/ai-agents"]

# ---------------------------------------------------------------------------
# Models are agnostic. Eve speaks to any model or AI gateway via its adapters.
# Swap any model or provider here in .env — no code change required.
# Resolution per role: MODEL_<ROLE>_* -> MODEL_* (no built-in default model id).
# Right model for the job:
#   - Orchestrator: a reasoning-class model (request resolution, fan-out, coordination).
#   - Scout: a fast NON-reasoning-class model. The model is glue only; a heavy
#     reasoning model here risks runaway chain-of-thought and infinite loops.
# ---------------------------------------------------------------------------

# Shared fallback (used by any role that does not set its own override).
MODEL=<fast-non-reasoning-model-id>
MODEL_BASE_URL=<your-model-or-gateway-base-url>
MODEL_API_KEY=<your-provider-key>

# Orchestrator: reasoning-class model.
MODEL_ORCHESTRATOR=<reasoning-class-model-id>
MODEL_ORCHESTRATOR_BASE_URL=
MODEL_ORCHESTRATOR_API_KEY=

# Repository Scout: fast, non-reasoning-class model (glue only).
MODEL_SCOUT=<fast-non-reasoning-model-id>
MODEL_SCOUT_BASE_URL=
MODEL_SCOUT_API_KEY=

# Report assembly is a deterministic tool (no LLM reporter), so no MODEL_REPORTER is needed.

# ---------------------------------------------------------------------------
# Cost & loop guardrails (see openspec/adr/0001 §5 and openspec/adr/0002).
# Eve exposes no hard per-agent step ceiling, so loop discipline is enforced by
# model selection (non-reasoning scout) and made auditable via summary.json.
# These optional soft budgets flag a run (budget.exceeded) when crossed:
RUN_STEP_BUDGET=
RUN_WALL_CLOCK_BUDGET_S=
# Optional: override the cost rate card location (defaults to shared/cost/rates.yaml).
# COST_RATES_FILE=

# ---------------------------------------------------------------------------
# Sandbox infra cleanup (local Docker dev only).
# After a run, stopped eve-sbx-* containers are reaped automatically (at the
# start of the next run and by the final cleanup_sandbox step). Running
# containers are never removed. Set to off/false/0 to disable.
EVE_SANDBOX_CLEANUP=on

# Daily schedule runs at 01:00 UTC. Change agent/schedules/daily-pr-digest.md.
