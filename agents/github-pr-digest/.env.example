# GitHub authentication (fine-grained PAT or GitHub App token)
GITHUB_TOKEN=github_pat_xxx

# JSON array of owner/repository names used when the prompt omits repositories.
GITHUB_REPOSITORIES=["vercel/eve","senthilsweb/ai-agents"]

# OpenRouter free-model router. It selects a currently available free model
# that supports requested features such as tool calling.
OPENROUTER_API_KEY=sk-or-v1-xxx
MODEL=openrouter/free
MODEL_BASE_URL=https://openrouter.ai/api/v1

# Optional role overrides. All fall back to MODEL / MODEL_BASE_URL / MODEL_API_KEY.
MODEL_ORCHESTRATOR=openrouter/free
MODEL_SCOUT=openrouter/free
MODEL_REPORTER=openrouter/free

# Optional. Defaults to OPENROUTER_API_KEY.
MODEL_API_KEY=

# Daily schedule runs at 01:00 UTC. Change agent/schedules/daily-pr-digest.md.
