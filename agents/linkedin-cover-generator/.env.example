# ── LinkedIn Cover Agent — environment configuration ───────────────────────
#
# Eve loads .env / .env.local from the agent folder when you run `eve dev`
# from agents/linkedin-cover-generator/. This keeps each agent's secrets isolated.
#
# Copy this file to .env in this folder:
#   cp .env.example .env
#
# Models are model-agnostic and env-driven. There is NO built-in default model
# id — each role resolves MODEL_<ROLE>_* → MODEL_* → an explicit startup error.
# See openspec/adr/0001-shared-agent-runtime-kit.md §4.

# ── Orchestrator (the single creative cover-spec pass) ────────────────────
# A light reasoning + vision capable model. Finalized default: gpt-5.4-mini on
# OpenAI. The orchestrator runs exactly one bounded pass to author the cover
# spec; report assembly is a deterministic tool (no reporter model).
MODEL_ORCHESTRATOR=gpt-5.4-mini
MODEL_ORCHESTRATOR_BASE_URL=https://api.openai.com/v1
MODEL_ORCHESTRATOR_API_KEY=your-openai-key

# ── Image generation ──────────────────────────────────────────────────────
# The cover image itself. Finalized default: OpenAI gpt-image-2. Configured
# independently of the orchestrator via the IMAGE_* vars.
IMAGE_MODEL=gpt-image-2
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your-openai-key
IMAGE_QUALITY=high

# ── Loop control ──────────────────────────────────────────────────────────
# Disable review and retry by default to minimize cost.
ENABLE_REVIEW=false
MAX_IMAGE_RETRIES=0

# ── Cost reporting ──────────────────────────────────────────────────────────
# Set to false to disable cost computation in render_and_save_report. Cost is
# estimated from the shared cost matrix (shared/cost/rates.yaml); populate that
# rate card with the model ids you actually run. See openspec/adr/0002.
ALLOW_COST=true

# ── Generic fallback (simplest single-model setup) ────────────────────────
# If only MODEL* is set, the orchestrator falls back to it.
# MODEL=gpt-5.4-mini
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=your-openai-key
# (IMAGE_* vars are still needed separately for image generation)

# ── Vercel AI Gateway (optional) ──────────────────────────────────────────
# MODEL_ORCHESTRATOR=openai/gpt-5.4-mini
# AI_GATEWAY_API_KEY=...
# (leave BASE_URL unset for the gateway path)

# ── Soft run budgets (observability only) ─────────────────────────────────
# RUN_STEP_BUDGET=40
# RUN_WALL_CLOCK_BUDGET_S=300

# ── Context window override (optional) ────────────────────────────────────
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# MODEL_CONTEXT_WINDOW_TOKENS=128000

# ── Observability (optional; off unless an endpoint is set) ────────────────
# Traces export via the shared OTel pipeline (shared/lib/instrumentation.ts).
# Local Phoenix: docker run -d --name phoenix -p 6006:6006 arizephoenix/phoenix:latest
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=api_key=your-key
# Set false to omit prompts/completions/tool payloads on spans (deployed envs).
# TELEMETRY_RECORD_IO=true

# ── Object storage for run artifacts (optional; no-op unless bucket set) ───
# Uploads the whole runs/<run-id>/ folder after sync_run_to_host. Needed for
# deployed environments; local dev already has the host mirror on disk.
# OBJECT_STORE_BUCKET=my-agent-runs
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ACCESS_KEY_ID=...
# OBJECT_STORE_SECRET_ACCESS_KEY=...
# MinIO / non-AWS S3-compatible endpoints only:
# OBJECT_STORE_ENDPOINT=https://minio.internal:9000
# OBJECT_STORE_FORCE_PATH_STYLE=true
# Set when the bucket/CDN is publicly reachable (adds publicUrl per file):
# OBJECT_STORE_PUBLIC_BASE_URL=https://cdn.example.com

# ── Microsoft Teams channel (optional) ─────────────────────────────────────
# Azure Bot registration credentials. The channel mounts POST /eve/v1/teams
# and verifies the Bot Connector JWT on every request. See
# docs/consume-from-teams.md for the full setup walkthrough.
# MICROSOFT_APP_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_APP_PASSWORD=your-bot-client-secret
# MICROSOFT_TENANT_ID=          # only for single-tenant bots
