# Copy to .env for local runs. In CI these come from GitHub secrets.

# Deployed job-matcher endpoints
JOBMATCH_API_BASE=https://jobmatch-api.nathansweb.com
JOBMATCH_AGENT_BASE=https://jobmatch-agent.nathansweb.com

# Gmail SMTP (app password) — gate decision 2026-07-15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=              # one or more addresses, comma-separated
DIGEST_FROM=

# Paid-call guard: the pipeline refuses to call /analyze without this
RUN_PAID_MATCH=0

# Letterhead phone for cover-letter PDFs — kept out of the committed
# templates/letterhead.yaml because this repo is public
LETTERHEAD_PHONE=

# Observability (all optional — absence degrades to a logged warning)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-pilot
# OTel dual export per the repo's env contract (shared/lib/instrumentation.ts):
# OpenObserve + Arize Phoenix (local Docker on 6006, or Arize's hosted
# Phoenix Cloud with PHOENIX_CLIENT_HEADERS=api_key=...).
# Base URLs are fine — /v1/traces is appended automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.nathansweb.com/api/default
OTEL_EXPORTER_OTLP_HEADERS=
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_CLIENT_HEADERS=
