# ── Diagram Generator Agent — environment configuration ────────────────────
#
# Eve loads .env / .env.local from the agent folder when you run `eve dev`
# from agents/diagram-generator/. This keeps each agent's secrets isolated.
#
# Copy this file to .env in this folder:
#   cp .env.example .env
#
# Models are model-agnostic and env-driven. There is NO built-in default model
# id — each role resolves MODEL_<ROLE>_* → MODEL_* → an explicit startup error.
# See openspec/adr/0001-shared-agent-runtime-kit.md §4.

# ── Orchestrator (intake, spec authoring, image OCR, layout planning) ──────
# A strong reasoning + vision capable model. Finalized default: gpt-5.4-mini on
# OpenAI. The orchestrator owns planning and bookkeeping; it does not render.
MODEL_ORCHESTRATOR=gpt-5.4-mini
MODEL_ORCHESTRATOR_BASE_URL=https://api.openai.com/v1
MODEL_ORCHESTRATOR_API_KEY=your-openai-key

# ── Renderer (HTML diagram generation) ─────────────────────────────────────
# A fast, non-reasoning model — rendering is execution-heavy, not reasoning-
# heavy. Finalized default: gpt-4o-mini on OpenAI. Capped by RENDER_MAX_ITERATIONS
# and a per-render wall-clock budget so it cannot loop indefinitely.
MODEL_RENDERER=gpt-4o-mini
MODEL_RENDERER_BASE_URL=https://api.openai.com/v1
MODEL_RENDERER_API_KEY=your-openai-key

# ── Image generation (optional rasterized preview) ─────────────────────────
# Used only if the harness rasterizes a preview via an image model. The headless
# screenshot QC path uses Playwright, not this model.
IMAGE_MODEL=gpt-image-2
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your-openai-key

# ── Cost reporting ──────────────────────────────────────────────────────────
# Set to false to disable cost computation in render_and_save_report. Cost is
# estimated from the shared cost matrix (shared/cost/rates.yaml); populate that
# rate card with the model ids you actually run. See openspec/adr/0002.
ALLOW_COST=true

# ── Renderer guardrails ─────────────────────────────────────────────────────
# Maximum self-verify screenshot iterations per render, and the per-render
# wall-clock ceiling (seconds). On exceed, the renderer records qc.passed=false
# and returns its best effort.
RENDER_MAX_ITERATIONS=4
RENDER_WALL_CLOCK_BUDGET_S=240

# ── Soft run budgets (observability only) ──────────────────────────────────
# When tripped, the run still emits summary.json (with budget.exceeded=true).
# RUN_STEP_BUDGET=60
# RUN_WALL_CLOCK_BUDGET_S=600

# ── Generic fallback (simplest single-model setup) ─────────────────────────
# If only MODEL* is set, all roles fall back to it.
# MODEL=gpt-5.4-mini
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=your-openai-key

# ── Vercel AI Gateway (optional) ───────────────────────────────────────────
# MODEL_ORCHESTRATOR=openai/gpt-5.4-mini
# MODEL_RENDERER=openai/gpt-4o-mini
# AI_GATEWAY_API_KEY=...
# (leave BASE_URL unset for the gateway path)

# ── Context window override (optional) ─────────────────────────────────────
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# MODEL_RENDERER_CONTEXT_WINDOW_TOKENS=128000
# MODEL_CONTEXT_WINDOW_TOKENS=128000
