# ── LinkedIn Cover Agent — environment configuration ───────────────────────
#
# Eve loads .env / .env.local from the agent folder when you run `eve dev`
# from agents/agent-linkedin-cover/. This keeps each agent's secrets isolated.
#
# Copy this file to .env in this folder:
#   cp .env.example .env
#
# All vars are optional — defaults use z.ai GLM models. Role-specific vars
# fall back to the generic MODEL* vars.

# ── Example A: z.ai GLM (cheapest, recommended for testing) ───────────────
# The orchestrator uses a fast, cheap reasoning model. z.ai's GLM-4.5-Air
# is the equivalent of gpt-5.4-mini in the GPT family.
MODEL_ORCHESTRATOR=glm-4.5-air
MODEL_ORCHESTRATOR_BASE_URL=https://api.z.ai/api/paas/v4/
MODEL_ORCHESTRATOR_API_KEY=your-z-ai-key

# Optional reviewer (only used when ENABLE_REVIEW=true).
# glm-4.5-air is the equivalent of gpt-5.4-nano.
MODEL_REVIEWER=glm-4.5-air
MODEL_REVIEWER_BASE_URL=https://api.z.ai/api/paas/v4/
MODEL_REVIEWER_API_KEY=your-z-ai-key

# Image generation. z.ai does not host an image model, so use OpenAI's
# gpt-image-2 (or any OpenAI-compatible image endpoint). Set IMAGE_API_KEY
# and IMAGE_BASE_URL to point at the image provider.
IMAGE_MODEL=gpt-image-2
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your-openai-key
IMAGE_QUALITY=high

# ── Loop control ──────────────────────────────────────────────────────────
# Disable review and retry by default to minimize cost.
ENABLE_REVIEW=false
MAX_IMAGE_RETRIES=0

# ── Example B: same model for orchestrator + reviewer (simplest) ──────────
# MODEL=glm-4.5-air
# MODEL_BASE_URL=https://api.z.ai/api/paas/v4/
# MODEL_API_KEY=your-z-ai-key
# (IMAGE_* vars still needed separately for image generation)

# ── Example C: Vercel AI Gateway ──────────────────────────────────────────
# MODEL_ORCHESTRATOR=anthropic/claude-sonnet-4.6
# AI_GATEWAY_API_KEY=...
# (leave BASE_URL unset for the gateway path)

# ── Context window override (optional) ────────────────────────────────────
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# MODEL_CONTEXT_WINDOW_TOKENS=128000
