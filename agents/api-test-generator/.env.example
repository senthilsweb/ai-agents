# ── API Test Generator Agent — environment configuration ───────────────────
#
# Eve loads .env / .env.local from the agent folder when you run `eve dev`
# from agents/api-test-generator/. This keeps each agent's secrets isolated.
#
# Copy this file to .env in this folder:
#   cp .env.example .env
#
# Models are model-agnostic and env-driven. There is NO built-in default model
# id — each role resolves MODEL_<ROLE>_* → MODEL_* → an explicit startup error.
# See openspec/adr/0001-shared-agent-runtime-kit.md §4.
#
# Model selection rationale:
#   Orchestrator  — claude-sonnet-4-6  : coordination only; correct price for the task
#   Pairwise Dsgn — claude-opus-4-8    : complex factor analysis needs full reasoning
#   Assertion Wtr — claude-haiku-4-5   : bulk template-following generation; cheapest correct choice

# ── Orchestrator (coordination, run bookkeeping, sequential tool calls) ─────
MODEL_ORCHESTRATOR=claude-sonnet-4-6
# MODEL_ORCHESTRATOR_BASE_URL=https://api.anthropic.com/v1
# MODEL_ORCHESTRATOR_API_KEY=your-anthropic-key

# ── Pairwise Designer (complex combinatorial factor analysis — runs once) ───
MODEL_PAIRWISE_DESIGNER=claude-opus-4-8
# MODEL_PAIRWISE_DESIGNER_BASE_URL=https://api.anthropic.com/v1
# MODEL_PAIRWISE_DESIGNER_API_KEY=your-anthropic-key

# ── Assertion Writer (bulk pm.test() generation — fast, cheap) ──────────────
MODEL_ASSERTION_WRITER=claude-haiku-4-5-20251001
# MODEL_ASSERTION_WRITER_BASE_URL=https://api.anthropic.com/v1
# MODEL_ASSERTION_WRITER_API_KEY=your-anthropic-key

# ── Cost reporting ──────────────────────────────────────────────────────────
# Set to false to disable cost computation in assemble_report.
ALLOW_COST=true

# ── Subagent step budgets (infinite-loop prevention) ───────────────────────
ORCHESTRATOR_MAX_STEPS=30
PAIRWISE_MAX_STEPS=15
ASSERTION_MAX_STEPS=20

# ── Newman execution ────────────────────────────────────────────────────────
NEWMAN_TIMEOUT_MS=30000
NEWMAN_BAIL=false

# ── Soft run budgets (observability only) ──────────────────────────────────
# RUN_STEP_BUDGET=100
# RUN_WALL_CLOCK_BUDGET_S=900

# ── Generic fallback (simplest single-model setup) ─────────────────────────
# If only MODEL* is set, all roles fall back to it.
# MODEL=claude-sonnet-4-6
# AI_GATEWAY_API_KEY=...

# ── Context window override (optional) ─────────────────────────────────────
# MODEL_ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=200000
# MODEL_PAIRWISE_DESIGNER_CONTEXT_WINDOW_TOKENS=200000
# MODEL_ASSERTION_WRITER_CONTEXT_WINDOW_TOKENS=200000
# MODEL_CONTEXT_WINDOW_TOKENS=200000

# ── Object store publish (optional) ────────────────────────────────────────
#
# When PUBLISH_S3_URI is set, the orchestrator calls publish_results after
# assemble_report to upload structured analytics artifacts to the object store.
# The path is Hive-partitioned so DuckDB can query across runs directly:
#
#   <PUBLISH_S3_URI>/year=YYYY/month=MM/day=DD/api_name=<name>/run_id=<id>/
#     structured/test_results.jsonl   — per-execution results (DuckDB-queryable)
#     structured/coverage.json        — run-level metrics
#     structured/matrix.jsonl         — pairwise matrix rows
#     structured/query_hints.sql      — ready-to-run DuckDB examples
#
# DuckDB query example:
#   SELECT feature, status, COUNT(*) FROM
#     read_json_auto('s3://bucket/api-tests/**/test_results.jsonl',
#                    hive_partitioning=true)
#   GROUP BY ALL;
#
# AWS S3 (standard):
# PUBLISH_S3_URI=s3://my-bucket/api-tests
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
#
# MinIO or S3-compatible (set endpoint URL):
# PUBLISH_S3_URI=s3://my-bucket/api-tests
# PUBLISH_S3_ENDPOINT_URL=http://minio:9000
# PUBLISH_S3_BUCKET_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
#
# Partition order (default: date/api_name/run_id):
# PUBLISH_PARTITION_BY=date/api_name/run_id
#   → year=YYYY/month=MM/day=DD/api_name=X/run_id=Y/   (best for time-range scans)
# PUBLISH_PARTITION_BY=api_name/date/run_id
#   → api_name=X/year=YYYY/month=MM/day=DD/run_id=Y/   (best for single-API history)
# PUBLISH_PARTITION_BY=flat
#   → <run_id>/  (no partition columns — simple, not for cross-run analytics)
#
# Set to true to also publish collection.json, data.json, pairwise_matrix.csv:
# PUBLISH_INCLUDE_RAW=false
