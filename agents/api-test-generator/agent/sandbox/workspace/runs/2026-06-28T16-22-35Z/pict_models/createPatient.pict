# PICT Model — createPatient (GET /<createPatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T16:25:54.024Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: no_token, insufficient_scope_token, read_token, write_token, admin_token
firstName_presence: provided, omit
lastName_presence: provided, omit
orgId_presence: provided, omit
status: omit, active, inactive, deceased
dateOfBirth: omit, valid_past_date, future_date
duplicate: unique, duplicate

# Constraints
# IF [role] = "no_token" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "insufficient_scope_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [role] = "read_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [firstName_presence] = "omit" → expect HTTP 400 (see constraints in factors_model.json)
# IF [lastName_presence] = "omit" → expect HTTP 400 (see constraints in factors_model.json)
# IF [orgId_presence] = "omit" → expect HTTP 400 (see constraints in factors_model.json)
# IF [dateOfBirth] = "future_date" → expect HTTP 422 (see constraints in factors_model.json)
# IF [duplicate] = "duplicate" → expect HTTP 409 (see constraints in factors_model.json)

