# PICT Model — updatePatient (GET /<updatePatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T16:25:54.024Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: no_token, insufficient_scope_token, read_token, write_token, admin_token
patientId: valid_existing_uuid, valid_nonexistent_uuid, malformed_non_uuid
status_transition: omit, active_to_inactive, active_to_deceased, inactive_to_active, deceased_to_active
firstName: omit, valid_short, max_length_100, over_max_101
lastName: omit, valid_short, max_length_100, over_max_101

# Constraints
# IF [role] = "no_token" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "insufficient_scope_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [role] = "read_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [patientId] = "valid_nonexistent_uuid" → expect HTTP 404 (see constraints in factors_model.json)
# IF [patientId] = "malformed_non_uuid" → expect HTTP 400 (see constraints in factors_model.json)
# IF [status_transition] = "deceased_to_active" → expect HTTP 422 (see constraints in factors_model.json)
# IF [firstName] = "over_max_101" → expect HTTP 400 (see constraints in factors_model.json)
# IF [lastName] = "over_max_101" → expect HTTP 400 (see constraints in factors_model.json)

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [row]="[object Object]", [_validation_type]="Smoke", [note]="Happy path: valid update, active→inactive transition — expect 200 with echoed fields"
# MUST: [row]="[object Object]", [_validation_type]="RBAC-Negative", [note]="No token — expect 401"
# MUST: [row]="[object Object]", [_validation_type]="RBAC-Negative", [note]="Read-only scope attempting update — expect 403"
# MUST: [row]="[object Object]", [_validation_type]="NotFound", [note]="Valid UUID, no record — expect 404"
# MUST: [row]="[object Object]", [_validation_type]="Validation-Format", [note]="Malformed patientId — expect 400"
# MUST: [row]="[object Object]", [_validation_type]="Boundary-Invalid", [note]="Invalid lifecycle transition deceased→active — expect 422"
# MUST: [row]="[object Object]", [_validation_type]="Smoke", [note]="Valid transition active→deceased — expect 200, response.status=deceased"
# MUST: [row]="[object Object]", [_validation_type]="Boundary-Max", [note]="firstName and lastName at maxLength=100 — expect 200 with exact echo"
# MUST: [row]="[object Object]", [_validation_type]="Boundary-OverMax", [note]="firstName one character over maxLength — expect 400"
