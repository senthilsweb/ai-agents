# PICT Model — listPatients (GET /<listPatients>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T16:25:54.024Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: no_token, insufficient_scope_token, read_token, write_token, admin_token
status: omit, active, inactive, deceased
orgId: omit, valid_org, unknown_org
limit: omit, 1, 20, 99, 100, 101
offset: omit, 0, 1

# Constraints
# IF [role] = "no_token" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "insufficient_scope_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [limit] = "101" → expect HTTP 400 (see constraints in factors_model.json)

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [row]="[object Object]", [_validation_type]="Smoke", [note]="Happy path: authorized read, status filter active, typical pagination"
# MUST: [row]="[object Object]", [_validation_type]="RBAC-Negative", [note]="No token — expect 401"
# MUST: [row]="[object Object]", [_validation_type]="RBAC-Negative", [note]="Wrong scope — expect 403"
# MUST: [row]="[object Object]", [_validation_type]="Boundary-Max", [note]="limit at maximum boundary — expect 200 with ≤ 100 records"
# MUST: [row]="[object Object]", [_validation_type]="Boundary-OverMax", [note]="limit one over maximum — expect 400"
# MUST: [row]="[object Object]", [_validation_type]="Filter", [note]="status filter = inactive — all returned records must have status=inactive"
# MUST: [row]="[object Object]", [_validation_type]="Filter", [note]="status filter = deceased — all returned records must have status=deceased"
