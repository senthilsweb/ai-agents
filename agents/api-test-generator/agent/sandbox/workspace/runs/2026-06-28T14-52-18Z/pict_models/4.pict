# PICT Model — 4 (GET /<4>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T14:54:58.739Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: delete_scope, write_scope, read_scope, anonymous
patientId: valid_existing_uuid, valid_nonexistent_uuid, invalid_format

# Constraints
# IF [role] = "anonymous" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "write_scope" → expect HTTP 403 (see constraints in factors_model.json)
# IF [role] = "read_scope" → expect HTTP 403 (see constraints in factors_model.json)
# IF [patientId] = "valid_nonexistent_uuid" → expect HTTP 404 (see constraints in factors_model.json)
# IF [patientId] = "invalid_format" → expect HTTP 400 (see constraints in factors_model.json)

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [role]="delete_scope", [patientId]="valid_existing_uuid", [_validation_type]="Smoke", [notes]="Happy path — patient deleted"
# MUST: [role]="anonymous", [patientId]="valid_existing_uuid", [_validation_type]="RBAC -ve", [notes]="No token → 401"
# MUST: [role]="write_scope", [patientId]="valid_existing_uuid", [_validation_type]="RBAC -ve", [notes]="Write scope cannot delete → 403"
# MUST: [role]="read_scope", [patientId]="valid_existing_uuid", [_validation_type]="RBAC -ve", [notes]="Read scope cannot delete → 403"
# MUST: [role]="delete_scope", [patientId]="valid_nonexistent_uuid", [_validation_type]="Not found", [notes]="Valid UUID but no record → 404"
# MUST: [role]="delete_scope", [patientId]="invalid_format", [_validation_type]="Invalid input", [notes]="Non-UUID format → 400"
