# PICT Model — createPatient (GET /<createPatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T15:56:33.620Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: write_token, read_token, no_token, insufficient_scope_token
firstName: short, 99_chars, 100_chars, 101_chars
lastName: short, 99_chars, 100_chars, 101_chars
status: omitted, active, inactive, deceased
dateOfBirth: omitted, valid_past_date, today, future_date
orgId: valid_org, missing

# Constraints
# IF [role] = "no_token" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "insufficient_scope_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [role] = "read_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [firstName] = "101_chars" → expect HTTP 400 (see constraints in factors_model.json)
# IF [lastName] = "101_chars" → expect HTTP 400 (see constraints in factors_model.json)
# IF [dateOfBirth] = "future_date" → expect HTTP 422 (see constraints in factors_model.json)
# IF [orgId] = "missing" → expect HTTP 400 (see constraints in factors_model.json)

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [_validation_type]="Smoke", [description]="Authorized write_token, all required fields, status omitted — expects 201 with status defaulting to active", [role]="write_token", [firstName]="short", [lastName]="short", [status]="omitted", [dateOfBirth]="valid_past_date", [orgId]="valid_org"
# MUST: [_validation_type]="RBAC -ve", [description]="Missing token — expects 401", [role]="no_token", [firstName]="short", [lastName]="short", [status]="omitted", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="RBAC -ve", [description]="Read-only token — expects 403", [role]="read_token", [firstName]="short", [lastName]="short", [status]="omitted", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="Functional", [description]="status=inactive on create — expects 201, response.status = inactive", [role]="write_token", [firstName]="short", [lastName]="short", [status]="inactive", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="Functional", [description]="status=deceased on create — expects 201, response.status = deceased", [role]="write_token", [firstName]="short", [lastName]="short", [status]="deceased", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="Boundary", [description]="firstName at maxLength=100 — expects 201", [role]="write_token", [firstName]="100_chars", [lastName]="short", [status]="omitted", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="Boundary", [description]="firstName over maxLength=101 — expects 400", [role]="write_token", [firstName]="101_chars", [lastName]="short", [status]="omitted", [dateOfBirth]="omitted", [orgId]="valid_org"
# MUST: [_validation_type]="Negative", [description]="Future dateOfBirth — expects 422", [role]="write_token", [firstName]="short", [lastName]="short", [status]="omitted", [dateOfBirth]="future_date", [orgId]="valid_org"
# MUST: [_validation_type]="Negative", [description]="Missing orgId — expects 400", [role]="write_token", [firstName]="short", [lastName]="short", [status]="omitted", [dateOfBirth]="omitted", [orgId]="missing"
