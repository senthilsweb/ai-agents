# PICT Model — updatePatient (GET /<updatePatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T15:56:33.620Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: write_token, read_token, no_token, insufficient_scope_token
patientId: valid_existing, valid_nonexistent, invalid_format
status: omitted, active, inactive, deceased
firstName: omitted, short, 100_chars, 101_chars
dateOfBirth: omitted, valid_past_date, future_date

# Constraints
# IF [role] = "no_token" → expect HTTP 401 (see constraints in factors_model.json)
# IF [role] = "insufficient_scope_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [role] = "read_token" → expect HTTP 403 (see constraints in factors_model.json)
# IF [patientId] = "valid_nonexistent" → expect HTTP 404 (see constraints in factors_model.json)
# IF [patientId] = "invalid_format" → expect HTTP 400 (see constraints in factors_model.json)
# IF [firstName] = "101_chars" → expect HTTP 400 (see constraints in factors_model.json)
# IF [dateOfBirth] = "future_date" → expect HTTP 422 (see constraints in factors_model.json)

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [_validation_type]="Smoke", [description]="Authorized write_token, valid existing patient, update firstName — expects 200, response echoes sent firstName", [role]="write_token", [patientId]="valid_existing", [firstName]="short", [status]="omitted", [dateOfBirth]="omitted"
# MUST: [_validation_type]="RBAC -ve", [description]="Missing token — expects 401", [role]="no_token", [patientId]="valid_existing", [firstName]="short", [status]="omitted", [dateOfBirth]="omitted"
# MUST: [_validation_type]="RBAC -ve", [description]="Read-only token — expects 403", [role]="read_token", [patientId]="valid_existing", [firstName]="short", [status]="omitted", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Functional", [description]="Status transition to inactive — expects 200, response.status = inactive", [role]="write_token", [patientId]="valid_existing", [firstName]="omitted", [status]="inactive", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Functional", [description]="Status transition to deceased — expects 200, response.status = deceased", [role]="write_token", [patientId]="valid_existing", [firstName]="omitted", [status]="deceased", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Negative", [description]="Deceased-to-active transition (patient pre-set to deceased) — expects 422", [role]="write_token", [patientId]="valid_existing", [firstName]="omitted", [status]="active", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Boundary", [description]="firstName at maxLength=100 — expects 200", [role]="write_token", [patientId]="valid_existing", [firstName]="100_chars", [status]="omitted", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Boundary", [description]="firstName over maxLength=101 — expects 400", [role]="write_token", [patientId]="valid_existing", [firstName]="101_chars", [status]="omitted", [dateOfBirth]="omitted"
# MUST: [_validation_type]="Negative", [description]="Future dateOfBirth — expects 422", [role]="write_token", [patientId]="valid_existing", [firstName]="omitted", [status]="omitted", [dateOfBirth]="future_date"
# MUST: [_validation_type]="Negative", [description]="Non-existent patientId — expects 404", [role]="write_token", [patientId]="valid_nonexistent", [firstName]="short", [status]="omitted", [dateOfBirth]="omitted"
