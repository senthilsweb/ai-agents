            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "security": [
        "bearerAuth"
      ],
      "requestName": "Update Patient",
      "folderName": "Patients",
      "assertionSuffix": "UpdatePatient"
    },
    {
      "operationId": "deletePatient",
      "method": "DELETE",
      "path": "/patients/{patientId}",
      "tag": "patients",
      "summary": "Delete a patient",
      "description": "Permanently removes the patient record. After a successful delete, any subsequent GET /patients/{patientId} for the same ID must return 404.\n",
      "deprecated": false,
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "UUID of the patient record"
        }
      ],
      "requestBody": null,
      "responses": {
        "204": {
          "description": "Patient deleted successfully (no body)",
          "content_type": null
        },
        "401": {
          "description": "Missing or invalid bearer token",
          "content_type": "text/html",
          "schema": {
            "type": "string"
          }
        },
        "403": {
          "description": "Token does not have delete:patients scope",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "404": {
          "description": "No patient found with this ID",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "security": [
        "bearerAuth"
      ],
      "requestName": "Delete Patient",
      "folderName": "Patients",
      "assertionSuffix": "DeletePatient"
    }
  ]
}
