      "method": "GET",
      "path": "/patients/{patientId}",
      "tag": "patients",
      "summary": "Get a patient",
      "description": "Returns the full patient record for the given UUID. The response will include all fields including those not present at creation time.\n",
      "deprecated": false,
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "UUID of the patient record"
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "Patient found",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "id",
              "firstName",
              "lastName",
              "status",
              "orgId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "Server-assigned unique identifier"
              },
              "firstName": {
                "type": "string",
                "maxLength": 100
              },
              "lastName": {
                "type": "string",
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "inactive",
                  "deceased"
                ]
              },
              "orgId": {
                "type": "string"
              },
              "dateOfBirth": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid bearer token",
          "content_type": "text/html",
          "schema": {
            "type": "string"
          }
        },
        "403": {
          "description": "Token does not have read:patients scope",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "404": {
          "description": "No patient found with this ID",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          },
          "example": {
            "code": "PATIENT_NOT_FOUND",
            "message": "Patient not found"
          }
        }
      },
      "security": [
        "bearerAuth"
      ],
      "requestName": "Get Patient",
      "folderName": "Patients",
      "assertionSuffix": "GetPatient"
    },
    {
      "operationId": "updatePatient",
      "method": "PUT",
      "path": "/patients/{patientId}",
      "tag": "patients",
      "summary": "Update a patient",
      "description": "Replaces the mutable fields of a patient record. The `id` and `orgId` cannot be changed. All provided fields are echoed back in the response exactly as sent (no server-side transformation). The `status` field transitions the patient'\"'\"'s enrollment lifecycle.\n",
      "deprecated": false,
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "UUID of the patient record"
        }
      ],
      "requestBody": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": {
              "type": "string",
              "maxLength": 100
            },
            "lastName": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "deceased"
              ]
            },
            "dateOfBirth": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Patient updated successfully",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "id",
              "firstName",
              "lastName",
              "status",
              "orgId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "Server-assigned unique identifier"
              },
              "firstName": {
                "type": "string",
                "maxLength": 100
              },
              "lastName": {
                "type": "string",
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "inactive",
                  "deceased"
                ]
              },
              "orgId": {
                "type": "string"
              },
              "dateOfBirth": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "400": {
          "description": "Invalid field value",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid bearer token",
          "content_type": "text/html",
          "schema": {
            "type": "string"
          }
        },
        "403": {
          "description": "Token does not have write:patients scope",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "404": {
          "description": "No patient found with this ID",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
