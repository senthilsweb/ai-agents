# PICT Model — updatePatient (GET /<updatePatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T15:26:18.421Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: write_token, full_token, read_token, no_token, insufficient_scope_token
patientId: valid_existing, valid_nonexistent, invalid_format
status_transition: active_to_inactive, inactive_to_active, active_to_deceased, deceased_to_active
firstName: omitted, short, 100_chars, 101_chars
lastName: omitted, short, 100_chars, 101_chars

# Constraints

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [row]="[object Object]", [_validation_type]="Smoke", [expected_status]="200", [note]="Happy path: valid update with status transition and field update."
# MUST: [row]="[object Object]", [_validation_type]="Functional", [expected_status]="200", [note]="Transition inactive to active: response.status must equal active."
# MUST: [row]="[object Object]", [_validation_type]="Functional", [expected_status]="200", [note]="Transition active to deceased: response.status must equal deceased."
