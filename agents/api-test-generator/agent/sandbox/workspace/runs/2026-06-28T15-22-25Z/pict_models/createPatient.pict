# PICT Model — createPatient (GET /<createPatient>)
# Strength: 2 (pairwise)
# Generated: 2026-06-28T15:26:18.421Z
# Tip: The constraint block is the most valuable part — keep it version-controlled.

role: write_token, full_token, read_token, no_token, insufficient_scope_token
firstName: short, 99_chars, 100_chars, 101_chars
lastName: short, 99_chars, 100_chars, 101_chars
status: omitted, active, inactive, deceased
orgId: valid_org, omitted
dateOfBirth: omitted, valid_date, invalid_format

# Constraints

# Must-include rows (≥1 Smoke + ≥1 RBAC-negative per endpoint)
# MUST: [row]="[object Object]", [_validation_type]="Smoke", [expected_status]="201", [note]="Happy path: minimal valid payload, status defaults to active."
# MUST: [row]="[object Object]", [_validation_type]="Functional", [expected_status]="201", [note]="Full payload with all optional fields: all fields echoed back correctly."
# MUST: [row]="[object Object]", [_validation_type]="Functional", [expected_status]="201", [note]="Status=inactive at creation: response.status must equal inactive."
# MUST: [row]="[object Object]", [_validation_type]="Functional", [expected_status]="201", [note]="Status=deceased at creation: response.status must equal deceased."
# MUST: [row]="[object Object]", [_validation_type]="RBAC -ve", [expected_status]="401", [note]="No token: must return 401."
# MUST: [row]="[object Object]", [_validation_type]="RBAC -ve", [expected_status]="403", [note]="read_token lacks write scope: must return 403."
# MUST: [row]="[object Object]", [_validation_type]="RBAC -ve", [expected_status]="403", [note]="Insufficient scope: must return 403."
# MUST: [row]="[object Object]", [_validation_type]="Boundary", [expected_status]="201", [note]="firstName and lastName at exact maxLength (100): must succeed and echo back correctly."
# MUST: [row]="[object Object]", [_validation_type]="Negative", [expected_status]="422", [note]="firstName over maxLength (101): must return 400 or 422."
# MUST: [row]="[object Object]", [_validation_type]="Negative", [expected_status]="422", [note]="lastName over maxLength (101): must return 400 or 422."
# MUST: [row]="[object Object]", [_validation_type]="Negative", [expected_status]="400", [note]="orgId omitted (required field): must return 400."
# MUST: [row]="[object Object]", [_validation_type]="Negative", [expected_status]="422", [note]="Invalid dateOfBirth format: must return 400 or 422."
