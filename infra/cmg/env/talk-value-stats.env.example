# ~/opt/cmg/talk-value-stats/.env — passed to the one-shot extract container
# via --env-file for the duration of a run only. chmod 600.

ANTHROPIC_API_KEY=sk-ant-...

# Repo rule: no hard-coded model defaults — extract.py exits without one.
# Resolution: MODEL_STATS_EXTRACTOR -> MODEL -> error.
MODEL_STATS_EXTRACTOR=claude-opus-5
