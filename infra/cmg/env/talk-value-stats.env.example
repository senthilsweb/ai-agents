# ~/opt/cmg/talk-value-stats/.env — passed to the one-shot extract container
# via --env-file for the duration of a run only. chmod 600.

ANTHROPIC_API_KEY=sk-ant-...

# Repo rule: no hard-coded model defaults — extract.py exits without one.
# Resolution: MODEL_STATS_EXTRACTOR -> MODEL -> error.
MODEL_STATS_EXTRACTOR=claude-opus-5

# Object-store state (add-object-store-state): when set, transcripts are
# read from the store and db.json syncs through it — no container mounts.
# NOTE the endpoint quirk: the owner's S3 API answers on the
# minio-console. hostname (the minio. one is the web console). Verified.
OBJECT_STORE_BUCKET=ai-agents
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=changeme
OBJECT_STORE_SECRET_ACCESS_KEY=changeme
OBJECT_STORE_ENDPOINT=https://minio-console.example.com
OBJECT_STORE_FORCE_PATH_STYLE=true
