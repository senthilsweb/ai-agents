# ~/opt/cmg/orchestrator/.env — config for the cmg A2A orchestrator. chmod 600.

ANTHROPIC_API_KEY=sk-ant-...

# Repo rule: no hard-coded model defaults.
# Resolution: MODEL_CMG_ORCHESTRATOR -> MODEL -> startup error.
# Orchestration is light (delegate, relay ids) — Sonnet is plenty.
MODEL_CMG_ORCHESTRATOR=claude-sonnet-5

# The deployed transcription service (see youtube-transcriber compose).
TRANSCRIBER_URL=http://localhost:8001

# Filled in by install.sh:
CMG_ROOT=__CMG_ROOT__
REPO=__REPO__

# One-shot stats image; point at a local tag while CI hasn't published.
STATS_IMAGE=ghcr.io/senthilsweb/talk-value-stats:latest

# Object-store mode flag (add-object-store-state D5): the presence of a
# bucket name switches the docker commands to their mount-free shape. The
# orchestrator never holds the store credentials — those live in the
# talk-value-stats/.env and transcriber/.env only.
OBJECT_STORE_BUCKET=ai-agents
