# ~/opt/cmg/youtube-transcriber/.env — runtime config for the deployed
# transcription service. No secrets required (fully local ASR, no API key).

# Hard cap on input length; the resolver rejects longer videos.
MAX_DURATION_MIN=180

# Optional: override the ASR model/language (defaults: distil-large-v3, auto).
# ASR_MODEL=distil-large-v3
# ASR_LANGUAGE=

# Optional fallback if YouTube blocks the host IP: export browser cookies to
# ~/opt/cmg/youtube-transcriber/cookies.txt, add this line, and add
#   - ./cookies.txt:/app/cookies.txt:ro
# to the compose volumes. Never commit a cookies file.
# YT_COOKIES_FILE=/app/cookies.txt

# Tracing (dual export, both optional; a bad backend degrades to a warning):
#   OpenObserve — eve-agent-form endpoint + Basic auth header
#   Arize AX    — PHOENIX_* pair (model_id resource attr is set in code)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 user:pass>
# PHOENIX_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1
# PHOENIX_CLIENT_HEADERS=space_id=<id>,api_key=<key>

# Object-store mirror of run artifacts (add-object-store-state): when set,
# every completed run also uploads its four artifacts to
# s3://$OBJECT_STORE_BUCKET/youtube-transcriber/runs/<stamp>-<id>/.
# Upload failure is a warning (metrics.upload_error), never a run failure.
OBJECT_STORE_BUCKET=ai-agents
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=changeme
OBJECT_STORE_SECRET_ACCESS_KEY=changeme
OBJECT_STORE_ENDPOINT=https://minio-console.example.com
OBJECT_STORE_FORCE_PATH_STYLE=true

# API-key gate (deploy-stats-managed-agent): REQUIRED before any public
# exposure. Unset = open service (loopback/local only). With it set, all
# endpoints except GET /healthz require a matching X-API-Key header.
# TRANSCRIBER_API_KEY=<openssl rand -hex 24>
