# ~/opt/cmg/youtube-transcriber/.env — runtime config for the deployed
# transcription service. No secrets required (fully local ASR, no API key).

# Hard cap on input length; the resolver rejects longer videos.
MAX_DURATION_MIN=180

# Optional: override the ASR model/language (defaults: distil-large-v3, auto).
# ASR_MODEL=distil-large-v3
# ASR_LANGUAGE=

# Optional fallback if YouTube blocks the host IP: export browser cookies to
# ~/opt/cmg/youtube-transcriber/cookies.txt, add this line, and add
#   - ./cookies.txt:/app/cookies.txt:ro
# to the compose volumes. Never commit a cookies file.
# YT_COOKIES_FILE=/app/cookies.txt
