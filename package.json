{
  "name": "ai-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "agents/*",
    "shared"
  ],
  "scripts": {
    "build": "npm -w agent-diagram-generator run build",
    "dev": "npm -w agent-diagram-generator run dev",
    "start": "npm -w agent-diagram-generator run start",
    "typecheck": "npm -w agent-diagram-generator run typecheck",
    "dev:linkedin": "npm -w linkedin-cover-generator run dev",
    "build:linkedin": "npm -w linkedin-cover-generator run build",
    "typecheck:linkedin": "npm -w linkedin-cover-generator run typecheck",
    "dev:privacy-classifier": "npm -w privacy-classifier run dev",
    "build:privacy-classifier": "npm -w privacy-classifier run build",
    "typecheck:privacy-classifier": "npm -w privacy-classifier run typecheck",
    "dev:job-matcher": "npm -w job-matcher run dev",
    "build:job-matcher": "npm -w job-matcher run build",
    "typecheck:job-matcher": "npm -w job-matcher run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@typescript/native-preview": "7.0.0-dev.20260523.1"
  },
  "overrides": {
    "ai": "7.0.0-beta.178"
  },
  "resolutions": {
    "ai": "7.0.0-beta.178"
  },
  "engines": {
    "node": "24.x"
  }
}
